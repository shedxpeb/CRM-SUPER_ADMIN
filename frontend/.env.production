# Production frontend environment — loaded automatically by Next.js when NODE_ENV=production
# NEXT_PUBLIC_* values are bake-time variables — rebuild required after changes.

# Super admin backend API URL (absolute URL — SUPER-ADMIN frontend calls directly)
# ⚠️ Must include /api/v1 suffix
NEXT_PUBLIC_API_URL=https://api-admin.buildxcrm.com/api/v1

# Node environment
NODE_ENV=production
