# =============================================================================
# SUPER-ADMIN FRONTEND — PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.production and fill in ONLY the values marked 🔧
# =============================================================================

# ── 🔧 REQUIRED: Change these for every deployment ───────────────────────────

# Super admin backend API URL (absolute URL — SUPER-ADMIN frontend calls directly)
# ⚠️ Must include /api/v1 suffix
NEXT_PUBLIC_API_URL=https://api-admin.buildxcrm.com/api/v1

# Node environment
NODE_ENV=production
