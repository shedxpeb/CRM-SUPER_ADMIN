// ============================================================================
// SUPER-ADMIN CONTROL PLANE — Prisma Schema
// Target database: peb-platform (dedicated platform DB, isolated from peb-crm)
// Conventions:
//   - id            : UUID primary key on every model
//   - createdById / updatedById : audit FKs
//   - createdAt / updatedAt     : timestamps on every mutable model
//   - version       : Int optimistic-lock counter on every mutable model
//   - isDeleted / deletedAt / deletedById : soft delete on operational models
//   - slug / key / email / code / prefix / number : natural unique keys
//   - correlationId : UUID/ULID for distributed tracing across all operations
//   - requestId      : UUID/ULID for HTTP request tracing (originates from X-Request-ID header)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SyncState {
  SYNCED
  PENDING
  SYNCING
  FAILED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum HealthStatus {
  HEALTHY
  WARNING
  CRITICAL
  OFFLINE
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
  EMAIL
  URL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

// ----------------------------------------------------------------------------
// 1. PLATFORM IDENTITY & ACCESS
// ----------------------------------------------------------------------------

model PlatformUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  passwordHash         String
  avatar               String?
  isActive             Boolean   @default(true)
  isLocked             Boolean   @default(false)
  lockedUntil          DateTime?
  loginAttempts        Int       @default(0)
  lastLoginAt          DateTime?
  lastLoginIp          String?
  mustChangePassword   Boolean   @default(false)
  passwordVersion      Int       @default(1)
  permissionVersion    Int       @default(1)
  lastPasswordChangeAt DateTime?
  department           String?
  designation          String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  roles                 PlatformUserRole[]
  sessions              PlatformSession[]
  refreshTokens         RefreshToken[]
  loginHistory          LoginAttempt[]
  auditLogs             PlatformAuditLog[]
  impersonationsStarted ImpersonationLog[]     @relation("Impersonator")

  @@index([isActive])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("platform_users")
}

model PlatformRole {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  permissions RolePermission[]
  users       PlatformUserRole[]

  @@index([isActive])
  @@index([isDeleted])
  @@map("platform_roles")
}

model Permission {
  id           String  @id @default(uuid())
  key          String  @unique // e.g. "leads:read", "tenants:suspend"
  module       String // module key: "leads", "customers", "projects", "tenants", "users", "roles", "permissions"
  label        String
  description  String?
  category     String  @default("general")
  isDeprecated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime @default(now())

  role       PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PlatformUserRole {
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("platform_user_roles")
}

model PlatformSession {
  id             String    @id @default(uuid())
  userId         String
  refreshToken   String    @unique
  deviceInfo     String?
  userAgent      String?
  ipAddress      String?
  location       String?
  isActive       Boolean   @default(true)
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokedById    String?

  user          PlatformUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("platform_sessions")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  sessionId           String
  userId              String
  expiresAt           DateTime
  isRevoked           Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  session PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    PlatformUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id            String    @id @default(uuid())
  email         String
  userId        String?
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())

  user PlatformUser? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model BlockedIp {
  id           String    @id @default(uuid())
  ipAddress    String    @unique
  reason       String?
  blockedById  String?
  blockedUntil DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  unblockedAt  DateTime?

  @@index([isActive])
  @@map("blocked_ips")
}

// ----------------------------------------------------------------------------
// 2. TENANT (ORGANIZATION) MANAGEMENT
// ----------------------------------------------------------------------------

model Tenant {
  id                  String       @id @default(uuid())
  name                String
  slug                String       @unique
  crmOrganizationId   String?      @unique // link to ADMIN-CRM Organization.id
  email               String?
  phone               String?
  domain              String?      @unique // custom domain
  status              TenantStatus @default(ACTIVE)
  maxUsers            Int          @default(25)
  maxStorageGB        Int          @default(10)
  modulesEnabled      Json?        // JSON array of enabled module keys
  permissionPool      Json?        // Pool of permissions delegated to tenant admin
  roleHierarchyEnabled Boolean     @default(true)
  maxRoleDepth        Int          @default(5) // Maximum hierarchy depth
  customPermissionsEnabled Boolean @default(false)
  syncState           SyncState    @default(PENDING)
  lastSyncedAt        DateTime?    // Last successful sync timestamp
  syncError           String?      // Last sync error message
  syncVersion         Int          @default(0) // Sync version for conflict detection
  notes               String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  moduleOverrides      TenantModuleOverride[]
  permissionGrants    TenantPermissionGrant[]
  impersonations      ImpersonationLog[]

  @@index([status])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([crmOrganizationId])
  @@index([syncState])
  @@index([lastSyncedAt])
  @@map("tenants")
}

model TenantModuleOverride {
  id        String   @id @default(uuid())
  tenantId  String
  moduleKey String // CRM module key: "leads", "customers", "projects", "inventory", "warehouse", "purchases", "tracking", "reports", "users", "roles"
  enabled   Boolean  @default(true)
  setById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_module_overrides")
}

model PermissionTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("general")
  permissions Json     // Array of permission keys
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  isDeleted   Boolean  @default(false)
  
  @@index([isActive])
  @@index([category])
  @@map("permission_templates")
}

model TenantPermissionGrant {
  id           String   @id @default(uuid())
  tenantId     String
  permissionId String
  grantedBy    String   // Super Admin ID
  grantedAt    DateTime @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  conditions   Json?    // Conditional permissions
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@index([expiresAt])
  @@map("tenant_permission_grants")
}

model ImpersonationLog {
  id              String    @id @default(uuid())
  superAdminId    String
  superAdminEmail String
  tenantId        String
  targetUserId    String?
  targetUserEmail String?
  reason          String?
  grantId         String?   @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  endedBy         String?

  superAdmin PlatformUser @relation("Impersonator", fields: [superAdminId], references: [id])
  tenant     Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
  @@index([superAdminId, startedAt])
  @@map("impersonation_logs")
}

// ----------------------------------------------------------------------------
// 3. SYSTEM CONFIGURATION
// ----------------------------------------------------------------------------

model PlatformSetting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       Json // typed value; secrets stored encrypted
  type        SettingType @default(STRING)
  description String?
  category    String      @default("general") // email | security | branding | general
  isSecret    Boolean     @default(false)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@index([category])
  @@map("platform_settings")
}

// ----------------------------------------------------------------------------
// 4. OBSERVABILITY
// ----------------------------------------------------------------------------

model PlatformAuditLog {
  id            String        @id @default(uuid())
  actorId       String?
  actorEmail    String?
  action        String // "tenant.suspended", "user.created", "role.assigned", ...
  targetType    String?
  targetId      String?
  targetName    String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  severity      AuditSeverity @default(INFO)
  requestId     String?
  correlationId String?
  tenantId      String?

  createdAt DateTime @default(now())

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([severity])
  @@index([correlationId])
  @@map("platform_audit_logs")
}

model HealthCheck {
  id             String       @id @default(uuid())
  service        String       @unique // "backend", "database", "redis", "api"
  status         HealthStatus
  responseTimeMs Int?
  message        String?
  errorDetails   String?
  lastCheckedAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@map("health_checks")
}

model HealthCheckHistory {
  id             String       @id @default(uuid())
  service        String
  status         HealthStatus
  responseTimeMs Int?
  message        String?
  errorDetails   String?
  checkedAt      DateTime     @default(now())

  @@index([service, checkedAt])
  @@map("health_check_history")
}

model PlatformError {
  id         String        @id @default(uuid())
  service    String
  type       String // "exception", "unhandled_rejection", "db_error", "auth_failure"
  message    String
  stackTrace String?
  file       String?
  method     String?
  lineNumber Int?
  metadata   Json?
  severity   ErrorSeverity @default(MEDIUM)
  status     ErrorStatus   @default(OPEN)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?
  createdAt  DateTime      @default(now())

  @@index([service, createdAt])
  @@index([status, severity])
  @@index([createdAt])
  @@map("platform_errors")
}

model ApiLog {
  id             String   @id @default(uuid())
  method         String
  path           String
  statusCode     Int
  responseTimeMs Int?
  ipAddress      String?
  userAgent      String?
  userId         String?
  tenantId       String?
  requestId      String?
  correlationId  String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@index([requestId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("api_logs")
}

model ApplicationLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  message   String
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([createdAt])
  @@map("application_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  component String // "auth", "tenant", "impersonation", "sync"
  level     LogLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([component, createdAt])
  @@map("system_logs")
}

model SlowQueryLog {
  id         String   @id @default(uuid())
  database   String   @default("peb-platform")
  query      String
  durationMs Int
  executedBy String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([durationMs])
  @@index([createdAt])
  @@map("slow_query_logs")
}