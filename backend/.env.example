# Application
NODE_ENV=development
PORT=8001
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001

# Database (configure these in production environment — never commit real credentials)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/peb-platform?sslmode=disable"
CRM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/BuildX?sslmode=disable"

# JWT
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=30m

# SMTP (optional in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Super Admin Seed (optional) — set a strong password before the first run
SUPER_ADMIN_EMAIL=admin@pebcrm.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
