# ============================================================================
# SUPER-ADMIN BACKEND — PRODUCTION ENVIRONMENT
# ============================================================================
# Copy this file to .env.production and fill in ONLY the values marked 🔧
# Everything else auto-derives or has safe defaults.
# ============================================================================

# ── 🔧 REQUIRED: Change these for every deployment ───────────────────────────

# Database — peb-platform (super admin platform database)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peb-platform?sslmode=require&connection_limit=20&pool_timeout=10"

# Database — peb-crm (read-only mirror for cross-database queries)
CRM_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peb-crm?sslmode=require&connection_limit=20&pool_timeout=10"

# Secrets (generate with: openssl rand -base64 48)
# ⚠️ COOKIE_SECRET must be DIFFERENT from JWT_SECRET
JWT_SECRET=
COOKIE_SECRET=

# Your super-admin frontend domain
FRONTEND_URL=https://admin.proxsteelhub.com

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@pebplatform.io

# ── OPTIONAL: Only change if needed ──────────────────────────────────────────

# Server port (must match CloudPanel reverse proxy target)
PORT=3003

# Additional CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://proxsteelhub.com

# Rate limit (300 req/60s default — tune after load testing)
RATE_LIMIT_LIMIT=300

# Node environment
NODE_ENV=production
